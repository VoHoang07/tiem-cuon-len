# ==============================================================================
# MẪU CẤU HÌNH BIẾN MÔI TRƯỜNG (KHÔNG CHỨA KEY THẬT - AN TOÀN 100%)
# Bạn tự điền các giá trị thật trực tiếp trên: Vercel Dashboard -> Settings -> Environment Variables
# TUYỆT ĐỐI KHÔNG gửi các giá trị Secret lên khung Chat AI hoặc commit lên GitHub!
# ==============================================================================

# 1. Supabase Mới (Dùng cho cả Client & Server)
EXPO_PUBLIC_SUPABASE_URL=https://your-new-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# 2. Supabase Server-Only Secret (CHỈ điền trên Vercel Dashboard, KHÔNG thêm tiền tố EXPO_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# 3. Cloudflare R2 Object Storage (CHỈ điền trên Vercel Dashboard cho api/media-upload.js)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=tiemcuonlen-media
R2_PUBLIC_BASE_URL=https://media.tiemcuonlen.shop

# 4. (Tùy chọn) Goship & SePay Server Secrets (CHỈ điền trên Vercel Dashboard)
SEPAY_WEBHOOK_SECRET=your-sepay-webhook-secret
GOSHIP_ACCESS_TOKEN=your-goship-developer-token
GOSHIP_CLIENT_SECRET=your-goship-client-secret
